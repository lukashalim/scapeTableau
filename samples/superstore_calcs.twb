<?xml version='1.0' encoding='utf-8' ?>
<!-- synthetic Superstore-shaped workbook for EscapeTableau tests -->
<workbook source-build='2024.1.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <repository-location id='superstore_calcs' path='/workbooks' />
  <datasources>
    <datasource caption='Sample Superstore' inline='true' name='federated.0abc' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Orders' name='textscan.orders'>
            <connection class='textscan' directory='' filename='Orders.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.orders' name='Orders' table='[Orders.csv]' type='table' />
      </connection>
      <column caption='Sales' datatype='real' name='[Sales]' role='measure' type='quantitative' />
      <column caption='Profit' datatype='real' name='[Profit]' role='measure' type='quantitative' />
      <column caption='Total Profit' datatype='real' name='[Total Profit]' role='measure' type='quantitative' />
      <column caption='Total Revenue' datatype='real' name='[Total Revenue]' role='measure' type='quantitative' />
      <column caption='Discount' datatype='real' name='[Discount]' role='measure' type='quantitative' />
      <column caption='Quantity' datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
      <column caption='Product Name' datatype='string' name='[Product Name]' role='dimension' type='nominal' />
      <column caption='Customer Name' datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column caption='Region' datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column caption='Internal Order Id' datatype='string' hidden='true' name='[Internal Order Id]' role='dimension' type='nominal' />
      <column caption='Category' datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_6012345678901234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Profit or Zero' datatype='real' name='[Calculation_6012345678901235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Profit])' />
      </column>
      <column caption='Discount Filled' datatype='real' name='[Calculation_6012345678901236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount], 0)' />
      </column>
      <column caption='High Sales Flag' datatype='string' name='[Calculation_6012345678901237]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Sales] &gt; 1000, &quot;High&quot;, &quot;Normal&quot;)' />
      </column>
      <column caption='Has Table' datatype='boolean' name='[Calculation_6012345678901238]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Product Name], &quot;Table&quot;)' />
      </column>
      <column caption='Name Starts A' datatype='boolean' name='[Calculation_6012345678901239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STARTSWITH([Customer Name], &quot;A&quot;)' />
      </column>
      <column caption='Sales Band' datatype='string' name='[Calculation_6012345678901240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt; 1000 THEN &quot;High&quot; ELSEIF [Sales] &gt; 500 THEN &quot;Medium&quot; ELSE &quot;Low&quot; END' />
      </column>
      <column caption='Regional Sales' datatype='real' name='[Calculation_6012345678901241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Region] : SUM([Sales])}' />
      </column>
      <column caption='Name Length' datatype='integer' name='[Calculation_6012345678901242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LEN(TRIM([Customer Name]))' />
      </column>
      <column caption='Upper Category' datatype='string' name='[Calculation_6012345678901243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Category])' />
      </column>
      <column caption='Mystery Metric' datatype='real' name='[Calculation_6012345678901244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SOMEUNKNOWN([Sales])' />
      </column>
      <column caption='Ratio Abs' datatype='real' name='[Calculation_6012345678901245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_6012345678901234])' />
      </column>
    </datasource>
    <datasource caption='West Custom SQL' inline='true' name='federated.west' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.west'>
            <connection class='postgres' dbname='analytics' filename='' password='s3cret' server='localhost;PWD=hunter2' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.west' name='WestOrders' type='text'>SELECT * FROM orders WHERE region = 'West'</relation>
      </connection>
      <column caption='West Profit' datatype='real' name='[Calculation_west_1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])' />
      </column>
    </datasource>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='no' />
      <column caption='Profit Goal' datatype='real' name='[Profit Goal]' param-domain-type='any' role='measure' type='quantitative' value='1000'>
        <calculation class='tableau' formula='1000' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample Superstore' name='federated.0abc' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0abc].[pcto:sum:Total Profit:qk]' />
              <text column='[federated.0abc].[pcto:sum:Total Revenue:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0abc].[none:Region:nk]</rows>
        <cols>[federated.0abc].[pcto:sum:Total Profit:qk]</cols>
      </table>
      <simple-id uuid='{11111111-1111-1111-1111-111111111111}' />
    </worksheet>
    <!-- Worksheet column-instance definitions (Tableau stores table-calc pills here) -->
    <worksheet name='Profit Mix'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample Superstore' name='federated.0abc' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc'>
            <column datatype='real' name='[Total Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Total Revenue]' role='measure' type='quantitative' />
            <column-instance column='[Total Profit]' derivation='Sum' name='[pcto:sum:Total Profit:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column-instance column='[Total Revenue]' derivation='Sum' name='[pcto:sum:Total Revenue:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
        </view>
        <rows>[federated.0abc].[none:Region:nk]</rows>
        <cols>[federated.0abc].[pcto:sum:Total Profit:qk] / [federated.0abc].[pcto:sum:Total Revenue:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Overview Dash'>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' name='Overview' type='layout-flow' w='50000' x='0' y='0' />
          <zone h='100000' name='Notes' type='text' w='50000' x='50000' y='0' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
