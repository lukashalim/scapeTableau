<[Sales Planning new].[usr:Achievement (variable) (copy):nk]> Quota Achieved]]></run>
                <run fontcolor='#000000' fontsize='9'>Æ </run>
                <run fontcolor='#666666' fontsize='9'>&#10;Total Sales: </run>
                <run fontcolor='#000000' fontsize='9'>Æ        </run>
                <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='9'><![CDATA[<[Sales Planning new].[sum:Achievement (copy):qk]>]]></run>
                <run fontcolor='#555555' fontsize='9'>&#10;Compensation:</run>
                <run fontcolor='#000000' fontsize='9'>Æ </run>
